# KARGA Intelligence Terminal - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# ArangoDB Configuration
# ===========================================
ARANGO_URL=http://localhost:8529
ARANGO_DB=QUANT_v3
ARANGO_USERNAME=root
ARANGO_PASSWORD=your-password-here

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# Perplexity AI (Web Search)
# ===========================================
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# ===========================================
# FastAPI Server Configuration
# ===========================================
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://karga.io

# ===========================================
# Error Tracking & Monitoring
# ===========================================
# Get your Sentry DSN from https://sentry.io
SENTRY_DSN=
# Options: development, staging, production
ENVIRONMENT=development

# ===========================================
# Cost & Abuse Protection
# ===========================================
# Maximum daily API spend (USD) - circuit breaker activates when exceeded
DAILY_API_BUDGET=50.0
# Maximum FOR loops allowed in builder mode queries
MAX_QUERY_COMPLEXITY=3

# ===========================================
# LLM Parameters (Advanced)
# ===========================================
MAX_TOKENS=1500
TEMPERATURE=0.1
QUERY_TIMEOUT=360
EMBEDDING_DIMENSIONS=1536

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================
# Before deploying to production:
# 1. Set ENVIRONMENT=production
# 2. Add your SENTRY_DSN for error tracking
# 3. Set appropriate DAILY_API_BUDGET
# 4. Update CORS_ORIGINS with your production domain
# 5. Use strong ARANGO_PASSWORD
# 6. Never commit this file to git (use .gitignore)
